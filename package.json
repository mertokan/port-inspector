{
  "name": "port-inspector",
  "version": "1.0.1",
  "description": "Interactive cross-platform CLI to inspect open/listening ports, the processes behind them, and which Node.js project each one belongs to.",
  "type": "module",
  "bin": {
    "ports": "bin/ports.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/ports.mjs",
    "once": "node bin/ports.mjs --once"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "keywords": [
    "ports",
    "netstat",
    "lsof",
    "process",
    "monitor",
    "node",
    "cli",
    "tui",
    "interactive",
    "devtools"
  ],
  "author": "Mert Okan <mert@talyasmart.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mertokan/port-inspector.git"
  },
  "bugs": {
    "url": "https://github.com/mertokan/port-inspector/issues"
  },
  "homepage": "https://github.com/mertokan/port-inspector#readme",
  "dependencies": {
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5"
  }
}
